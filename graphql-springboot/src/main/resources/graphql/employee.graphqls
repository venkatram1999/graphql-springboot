type Employee {
    id: ID!
    name: String!
    email: String!
    department: String!
}

type Query {
    employees: [Employee!]!
    employeeById(id: ID!): Employee
}

type Mutation {
    createEmployee(id: ID!, name: String!, email: String!, department: String!): Employee
    updateEmployeeById(id: ID!, name: String, email: String, department: String): Employee
    deleteEmployee(id: ID!): String
}

type Subscription {
    employeeCreated: Employee
    employeeUpdated: Employee
    employeeDeleted: Employee
}
